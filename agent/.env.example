# Переменные локального агента 3D-фермы TriDi.
# Скопируйте этот файл в .env (он в .gitignore) и заполните значения.

# Адрес приложения: локально http://localhost:3000, на сервере — боевой домен.
CRM_URL=http://localhost:3000
# Токен агента из настроек мастерской (uuid). Это секрет: он уходит только
# в заголовке Authorization и не должен попадать в git, журналы и URL.
AGENT_TOKEN=ваш_токен_из_настроек_мастерской
# Пауза между опросами очереди, секунды. Пусто или мусор — 5 секунд.
POLL_INTERVAL=5

# Обнаружение фермы (шаг 7.2): при старте агент обходит локальную сеть и
# отправляет найденные принтеры (Moonraker — порт 7125, OctoPrint — 80/443)
# в мастерскую, где мастер даёт им имена. Проход один на запуск: нужен
# повтор — перезапустите агент. Пусто или false — сеть не сканируется.
SCAN_NETWORK=false

# Подсети для обхода через запятую (можно без маски — тогда /24). По умолчанию
# агент берёт сеть своего адреса с маской /24, а если определить не удалось —
# 192.168.1.0/24 и 192.168.0.0/24. Цех в другом VLAN — впишите свой:
# SCAN_SUBNETS=192.168.1.0/24, 10.0.0.0/24
