{
  "name": "vase-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run ensure:tsconfig && next build",
    "build:amvera": "npm run clean && npm run ensure:tsconfig && npm run check:imports && next build --turbopack && node -e \"const fs=require('fs');fs.cpSync('public','.next/standalone/public',{recursive:true});fs.cpSync('.next/static','.next/standalone/.next/static',{recursive:true})\"",
    "check:docs": "node scripts/check-docs.mjs",
    "check:imports": "node scripts/check-imports.mjs",
    "check:style": "node scripts/style-check.mjs",
    "check:vase": "node --import ./scripts/register-alias.mjs scripts/test-vase-geometry.ts",
    "check:keychain": "node --import ./scripts/register-alias.mjs scripts/test-keychain-image.ts",
    "stats:lesson": "node scripts/lesson-stats.mjs",
    "shots:vase": "node --import ./scripts/register-alias.mjs scripts/vase-render.mjs",
    "shots:recipes": "node --import ./scripts/register-alias.mjs scripts/vase-render.mjs --recipes 1",
    "ensure:tsconfig": "node scripts/ensure-tsconfig.mjs",
    "clean": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\"",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@next/third-parties": "^15.5.28",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "15.5.25",
    "papaparse": "^5.7.0",
    "qrcode-generator": "^2.0.4",
    "qrcode.react": "^4.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.34.1",
    "three": "^0.186.0"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
