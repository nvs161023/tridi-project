# URL проекта из Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Публичный ключ (anon key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Приватный ключ (service_role) — НИКОМУ не показывать!
SUPABASE_SERVICE_ROLE_KEY=
# Ключ шифрования секретов (Api-Key Ozon) для AES-256-GCM. В production задайте
# отдельную длинную строку: смена ключа делает старые шифротексты нечитаемыми.
# Если пусто, берётся SHA-256 от service_role key. При расшифровке service-role
# key остаётся резервным, поэтому секрет можно добавить после первых сохранений.
ENCRYPTION_SECRET=
# Email администратора форума. Можно несколько через запятую.
# Если пусто, /admin/forum и действия модерации недоступны никому.
ADMIN_EMAIL=
# Секрет ежедневного отчёта: /api/cron/daily-report принимает только запросы
# с заголовком Authorization: Bearer <CRON_SECRET>. Пусто — роут отвечает 503.
CRON_SECRET=
# Resend: ключ API для писем с отчётом. Пусто — отчёт возвращается как HTML
# и не отправляется (удобно проверять локально).
RESEND_API_KEY=
# Отправитель писем. Домен должен быть подтверждён в Resend;
# onboarding@resend.dev — тестовый адрес Resend для первых проверок.
MAIL_FROM=TriDi <onboarding@resend.dev>
# Публичный адрес сайта: ссылки в письмах (подтверждение email) и редирект после
# выхода из аккаунта. На хостинге укажите боевой домен — https://tridi-print.ru
NEXT_PUBLIC_SITE_URL=
# Robokassa: логин магазина и пароли из технических настроек.
# В тестовом режиме нужны отдельные тестовые пароли №1 и №2.
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
# true — тестовые платежи, false — боевые. По умолчанию код считает режим тестовым.
ROBOKASSA_IS_TEST=true
# Автопродление подписки (включать только после обновления оферты и добавления кнопки отмены).
# true — в ссылке подписки появляется Recurring=true; false или пусто — продление ручное.
ROBOKASSA_RECURRING=false
# Секрет подписи сертификатов (HMAC). В production обязателен: без него страницы
# сертификата и проверки сообщают об ошибке. Если пусто, берётся service_role key.
CERTIFICATE_SECRET=
# Показывать ли на странице сертификата промокод партнёра «Слойтек».
# false — вместо промокода выводится заглушка «Партнерская программа скоро».
NEXT_PUBLIC_ENABLE_PARTNER_PROMO=false
# ProxyAPI: ключ для OCR накладных в Мастерской (OpenAI-совместимый шлюз,
# модель openai/gpt-4o). Имя переменной оставлено прежним.
# Пусто — /api/workshop/ocr отвечает 503 «OCR временно недоступен».
OPENAI_API_KEY=
# API-ключ от gen-api.ru (генерация 3D-моделей по фото, сеть Trellis 2).
# Пусто — /api/3d/generate отвечает 503 «Генерация 3D временно недоступна».
GEN_API_KEY=
# Модель генерации 3D в Gen API: trellis-2 (по умолчанию) или tripo-3d.
# У сетей разное поле с фото (image_url / image_urls) — код подставляет его сам.
GEN_API_MODEL=trellis-2
