# Tailwind CSS 4 uses the native @tailwindcss/oxide binary, который ставится как
# optional-зависимость под каждую платформу. Если установка идёт с omit=optional
# (как при сборке на Amvera), linux-бинарник пропускается и сборка падает с
# "Cannot find module '@tailwindcss/oxide-linux-x64-gnu'".
# Явно включаем optional-зависимости, чтобы linux-бинарник всегда попадал в node_modules.
include=optional
